			)
			(justify left bottom)
		)
		(uuid "859c367c-0641-5898-a391-3b214a98f0db")
	)
	(text "2x5 2.54 mm socket for the common W5500 module: 1 NC, 2 INT, 3\nRST, 4 GND, 5 5V (not connected: 3.3 V supply only), 6 SCLK, 7\nSCS, 8 MOSI, 9 MISO, 10 3.3V. CS GPIO39 (10k pull-up), RST from\nNET_RST (GPIO21). INT on GPIO44 (UART0 RX) through 1k, which\nlimits the current against the dev board USB-UART bridge. Own\nMISO (GPIO40), separate from the CAN MISO. 22u + 100n for ~130\nmA."
		(exclude_from_sim no)
		(at 629.92 172.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "986a1b4d-8ed5-5f1f-8ae9-914a16f90e6f")
	)
