	(text "Power"
		(exclude_from_sim no)
		(at 195.77 329.31 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4de549f7-e375-58e0-bea4-99b95f336b51")
	)
	(text "- Mains: at least 6.5 mm creepage and clearance from AC_L, AC_L_F, AC_L_NTC and AC_N to all SELV\n  copper and to the M3 and DIN-clip metal.\n- 12 V comes from the HLK-20M12 or the 12V IN/OUT terminal; the buck makes +5V for the SIM800L\n  and, through the LM66100, ESP_5V for everything else on 5 V. On USB alone all of it runs\n  except the SIM800L and the relay output."
		(exclude_from_sim no)
		(at 195.77 331.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "acf1b257-ac66-59dd-9dfa-3ea979ba598d")
	)
	(text "Controller"
		(exclude_from_sim no)
		(at 195.77 343.67 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6aa63a95-9493-5d88-9839-84aaba1e1a4c")
	)
	(text "- GPIO1 = IN_ADC (DOOR / IN1 / IN2), GPIO12 / GPIO48 = I2C, GPIO38 = relay output.\n- Five serial devices (SIM800L, RS-485 1-4) share the three ESP32-S3 UARTs through the GPIO\n  matrix."
		(exclude_from_sim no)
		(at 195.77 346.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "068630ba-51ca-58b0-98b6-78e56c55533a")
	)
	(text "Interfaces"
		(exclude_from_sim no)
		(at 195.77 353.91 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "05ad980e-0890-5a9a-bd5d-2f832f9e9f10")
	)
	(text "- RS-485 ports are numbered by GPIO (RX / TX): 1 = 6 / 7, 2 = 15 / 16, 3 = 18 / 5, 4 = 47 / 13.\n- Surge and ESD protection is on the HW-519 modules, at their terminals."
		(exclude_from_sim no)
		(at 195.77 356.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bf0aaf55-cc50-5a5f-bf69-dedb5f54c663")
	)
	(text "Network"
		(exclude_from_sim no)
		(at 195.77 362.09 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "67737dbf-a50d-59e4-bb17-fa407ca186df")
	)
	(text "- 3.3 V SPI bus (OLED, W5500, microSD, LoRa): SCK GPIO8, MOSI GPIO41, MISO GPIO40."
		(exclude_from_sim no)
		(at 195.77 364.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0d45d4c1-e6c5-53c7-9771-9d829c43ebcc")
	)
	(text "GSM"
		(exclude_from_sim no)
		(at 195.77 368.21 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0b44de01-d21d-54bc-9c7d-178719f227b1")
	)
	(text "- Fit either the SIM800L EVB (2G GSM/GPRS) or the A7670 board (4G LTE Cat-1), never both."
		(exclude_from_sim no)
		(at 195.77 370.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bb015395-d77f-5ef9-8320-b15a81cdaa66")
	)
	(text "Relay output"
		(exclude_from_sim no)
		(at 195.77 374.33 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "e0dfd996-8475-5619-a81b-3271d1279330")
	)
	(text "- The relay output runs from +12V, so it is not available on USB power alone."
		(exclude_from_sim no)
		(at 195.77 376.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c25eaf4b-0376-5333-b56b-5749fdc83fdb")
	)
