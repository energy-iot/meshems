	)
	(text "LM66100 ideal diode from the buck (+5V) to ESP_5V, which feeds the dev board, the four\nHW-519s, the CAN module, the TXS0108E 5 V side and the microSD module. On USB alone the\ndev board feeds ESP_5V, so everything except the SIM800L and the 12 V relay output\nruns; the LM66100 stops USB from back-feeding the buck. Up to ~0.95 A on 12 V (1.5 A\nrating)."
		(exclude_from_sim no)
		(at 492.76 19.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0d307952-abf4-5c07-b5a7-326663f528ec")
	)
