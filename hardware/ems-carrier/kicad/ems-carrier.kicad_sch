	(text "A7670 PWR-K select (solder jumper)"
		(exclude_from_sim no)
		(at 525.78 219.13 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7e784144-30c1-5b76-9c94-b53a332ce7aa")
	)
	(text "JP1 sets how the A7670 board is switched on. 1-2 (default,\ncopper bridge): from NET_RST through the BAT54, so firmware\npresses the power key by pulsing NET_RST low. 2-3 (cut 1-2,\nsolder 2-3): PWR-K held at GND, so the modem starts by\nitself at power-up. All open: for boards that switch\nthemselves on."
		(exclude_from_sim no)
		(at 527.05 221.63 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "868f19a1-6bd7-553b-9385-ab0c491b223b")
	)
