	)
	(text "10.5-16 V in from a 12 V battery system, or +12V out. SMBJ16CA clamps surges.\nAO4805 back-to-back P-FETs conduct only with correct polarity (2N7002 gate drive\nfrom a 1:2 divider); 100k from +12V lets them close when the board supplies 12 V\nout. Reversed: both FETs off."
		(exclude_from_sim no)
		(at 196.85 19.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
